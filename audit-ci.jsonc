{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Fail on moderate or higher so a new advisory anywhere in the tree is caught.
  // Only "low"/"info" findings (none currently) are allowed to pass silently.
  "moderate": true,
